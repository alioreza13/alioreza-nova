{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alioreza-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6e74d23f-aff7-4a8c-a460-0d1988298ba9","database_name": "alioreza-nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e5c5d2c6f5824598ae168af69a9d0fc6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
